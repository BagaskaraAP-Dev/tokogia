# ==============================================================================
# KONFIGURASI BACKEND & EMAIL NOTIFIKASI GIA'S PATISSERIE
# Salin file ini menjadi .env.local untuk pengujian lokal, atau masukkan
# variabel-variabel ini ke dashboard Settings -> Environment Variables di Vercel.
# ==============================================================================

# 1. EMAIL PENERIMA LAPORAN (Default: giacantik749@gmail.com)
EMAIL_TO=giacantik749@gmail.com

# 2. METODE PENGIRIMAN EMAIL (Pilih salah satu dari Opsi A atau Opsi B)

# --- OPSI A: Menggunakan Gmail Resmi (Google App Password) ---
# Cara buat App Password: Buka myaccount.google.com -> Keamanan -> Verifikasi 2 Langkah -> Sandi Aplikasi (App Password).
GMAIL_USER=giacantik749@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- OPSI B: Menggunakan Resend (Layanan Email API Vercel) ---
# Daftar gratis di resend.com dan buat API Key.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Gia's Patisserie <onboarding@resend.dev>

# 3. DATABASE ONLINE (SUPABASE) UNTUK AKSES DARI SEMUA PERANGKAT
# Buat project gratis di supabase.com, lalu salin Project URL dan Anon Key.
# Jalankan skrip di file 'supabase/schema.sql' di SQL Editor Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
